# Public client values only. Never put the service-role key in the web app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Deployed Edge Functions. Calls require an authenticated Admin user JWT.
VITE_SHEET_SYNC_FUNCTION=sync-sheet
VITE_SCREEN_API_FUNCTION=screen-api
VITE_PUBLISH_RELEASE_FUNCTION=publish-release

# Google Sheet source currently approved by the business owner.
VITE_SOURCE_SHEET_ID=1H0gZ6jW5KKvpP6WvdU07FdamYd8lWsOe9_WmdO6Z5PM

# Optional database UUID from public.sheet_sources. Leave empty to look up by spreadsheet ID.
VITE_SHEET_SOURCE_ID=

# Optional MP4/HLS-compatible URL for the Web TV demo. Empty keeps the animated fallback.
VITE_DEMO_VIDEO_URL=
