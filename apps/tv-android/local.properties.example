# Copy this file to local.properties and adjust sdk.dir for your machine.
# Never put a Supabase service_role key in an Android client.
sdk.dir=C\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk

# Public project values only. The anon key is protected by backend RLS/policies.
VINHDANH_SUPABASE_URL=
VINHDANH_SUPABASE_ANON_KEY=
