<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/pairing_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/pair_title"
            android:textColor="@color/gold_500"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/pair_instruction"
            android:textColor="@color/white_70"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/pairing_code"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pair_code"
            android:gravity="center"
            android:letterSpacing="0.18"
            android:padding="12dp"
            android:textColor="@color/navy_950"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pairing_device_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/white_70"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pairing_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/green_400"
            android:textSize="14sp" />

        <Button
            android:id="@+id/pair_now_button"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button"
            android:text="@string/pair_now"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playback_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <TextView
                android:id="@+id/branch_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/green_400"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/slide_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/recognition_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/recognition_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="@string/recognition_title"
                    android:textColor="@color/gold_500"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recognition_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/white_70"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/top_three_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="14dp"
                    android:layout_weight="1.35"
                    android:gravity="bottom"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="0.9"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/runner_column_left"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/runner_column_right"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/navy_950"
                android:visibility="gone">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/media_player_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="fit"
                    app:show_buffering="when_playing"
                    app:use_controller="false" />

                <TextView
                    android:id="@+id/video_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@color/black_55"
                    android:padding="18dp"
                    android:textColor="@color/white"
                    android:textSize="20sp" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/announcement_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="64dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/announcement_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/gold_500"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/announcement_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:lineSpacingExtra="8dp"
                    android:textColor="@color/white"
                    android:textSize="25sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/slide_logo"
                android:layout_width="200dp"
                android:layout_height="120dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:alpha="0"
                android:contentDescription="@string/slide_logo_description"
                android:elevation="12dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
